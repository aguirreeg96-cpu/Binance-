# ============================================================
# BINANCE SEMI-AUTO TRADER — EXAMPLE CONFIGURATION
# ============================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# This application defaults to PAPER mode (no real money).
# ============================================================

# ----- TRADING MODE -----
# Options: signal | paper | demo
# signal : generate signals only, no orders
# paper  : simulate trades using live market prices
# demo   : use Binance Spot Demo Mode with manual confirmation
# live mode is NOT implemented and will be rejected at startup.
TRADING_MODE=paper

# ----- BINANCE API (DEMO) -----
# Use ONLY Binance Spot Demo environment keys.
# Never paste real/production API keys here.
BINANCE_API_KEY=your_demo_api_key_here
BINANCE_API_SECRET=your_demo_api_secret_here

# ----- BINANCE ENDPOINTS -----
# Demo endpoints (default — do not change unless you know what you are doing)
BINANCE_BASE_URL=https://testnet.binance.vision
BINANCE_WS_URL=wss://testnet.binance.vision/ws

# ----- TRADING PARAMETERS -----
TRADING_SYMBOL=BTCUSDT
TRADING_INTERVAL=1h

# ----- RISK MANAGEMENT -----
RISK_PER_TRADE=0.005          # 0.5% of equity per trade
DAILY_LOSS_LIMIT=0.01         # 1.0% max daily loss
MAX_OPEN_POSITIONS=1
MAX_TRADES_PER_DAY=3
PAUSE_AFTER_LOSSES=2          # pause after N consecutive losses
MAX_POSITION_SIZE_PCT=0.20    # max 20% of balance in a single position
TRAILING_STOP_ENABLED=false

# ----- PAPER ACCOUNT -----
PAPER_INITIAL_BALANCE=10000.00  # USDT equivalent (educational only)

# ----- STRATEGY PARAMETERS -----
EMA_FAST=20
EMA_SLOW=50
EMA_TREND=200
RSI_PERIOD=14
RSI_MIN=50
RSI_MAX=65
ATR_PERIOD=14
ATR_SL_MULTIPLIER=1.5
RR_RATIO=2.0
VOLUME_MA_PERIOD=20

# ----- BACKTESTING -----
BACKTEST_COMMISSION=0.001     # 0.1% per trade
BACKTEST_SLIPPAGE=0.0005      # 0.05% slippage
BACKTEST_TRAIN_SPLIT=0.8      # 80% train / 20% validation

# ----- DEMO CONFIRMATION -----
DEMO_APPROVAL_TIMEOUT=60      # seconds before a pending order expires

# ----- APPLICATION -----
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO
DATABASE_URL=sqlite:///./trading.db
